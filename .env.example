# Copy to .env and fill in. Never commit .env.

# ── Highlight picker ──────────────────────────────────────────
# Nothing here is required. config.yaml defaults to a LOCAL Ollama model:
#     brew install ollama   (or https://ollama.com)
#     ollama pull qwen2.5:7b-instruct
# Only set these if you want a hosted model instead.
# CLIPPER_LLM_PROVIDER=anthropic      # ollama | anthropic | openai — overrides config.yaml
# CLIPPER_LLM_MODEL=claude-haiku-4-5-20251001
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_BASE_URL=https://your-gateway.example.com
# OPENAI_API_KEY=sk-...
# OLLAMA_HOST=http://localhost:11434  # if Ollama runs somewhere else

# ── YouTube Shorts (YouTube Data API v3, OAuth) ───────────────
# 1. console.cloud.google.com → new project → enable "YouTube Data API v3"
# 2. OAuth consent screen (External, add yourself as test user)
# 3. Credentials → OAuth client ID → Desktop app → download JSON → save as secrets/youtube_client_secret.json
# 4. Run `python -m clipper.publish.youtube --auth` once; token is cached to secrets/youtube_token.json
YOUTUBE_CLIENT_SECRET_FILE=secrets/youtube_client_secret.json
YOUTUBE_TOKEN_FILE=secrets/youtube_token.json

# ── Instagram Reels (Graph API) ───────────────────────────────
# Needs: Instagram Business/Creator account linked to a Facebook Page,
# a Meta app with instagram_content_publish + pages_read_engagement,
# and a long-lived user token. Get IG user id from /me/accounts → instagram_business_account.
IG_USER_ID=1784...
IG_ACCESS_TOKEN=EAAG...

# Reels API needs a public video URL → we upload to Cloudflare R2 (free 10GB) or S3
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=clips
R2_PUBLIC_BASE_URL=https://pub-xxxx.r2.dev   # enable public access on the bucket

# ── TikTok (Content Posting API) ──────────────────────────────
# developers.tiktok.com → app → add "Content Posting API" → scopes video.upload, video.publish
# Unaudited apps can only post SELF_ONLY (private). Submit for audit to unlock public posting.
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_ACCESS_TOKEN=
TIKTOK_REFRESH_TOKEN=
